# Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME="Arch Studio"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://archuser:archpass@localhost:5432/archdb
SYNC_DATABASE_URL=postgresql://archuser:archpass@localhost:5432/archdb

# Admin credentials (initial setup)
ADMIN_EMAIL=admin@archstudio.com
ADMIN_PASSWORD=AdminPass123!

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (use Gmail SMTP for free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=admin@archstudio.com

# File Upload
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Image dimensions
HERO_WIDTH=1920
HERO_HEIGHT=1080
PROJECT_COVER_WIDTH=1200
PROJECT_COVER_HEIGHT=800
PROJECT_GALLERY_WIDTH=1200
PROJECT_GALLERY_HEIGHT=900
BLOG_COVER_WIDTH=1200
BLOG_COVER_HEIGHT=628
TEAM_PHOTO_WIDTH=400
TEAM_PHOTO_HEIGHT=400

# Frontend URL
FRONTEND_URL=http://localhost:3000
