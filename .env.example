# Environment Configuration
# Copy this to .env and fill in your values

# --- Application ---
SECRET_KEY=change-me-in-production-minimum-32-characters
APP_ENV=development
DEBUG=true

# --- Admin ---
ADMIN_EMAIL=admin@archstudio.com
ADMIN_PASSWORD=AdminPass123!

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Email (optional - leave blank to skip) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=admin@archstudio.com

# --- Frontend ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MAP_LAT=40.7128
NEXT_PUBLIC_MAP_LNG=-74.0060
NEXT_PUBLIC_COMPANY_NAME=Arch Studio
NEXT_PUBLIC_COMPANY_EMAIL=hello@archstudio.com
NEXT_PUBLIC_COMPANY_PHONE=+1 (555) 000-0000
NEXT_PUBLIC_COMPANY_ADDRESS=123 Design District, New York, NY 10001
